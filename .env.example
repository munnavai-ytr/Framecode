# KEYS_SECRET: Required server secret (at least 32 characters) for BYOK cookie encryption
KEYS_SECRET="change-this-to-a-secret-string-at-least-32-chars-long"

# PIXABAY_API_KEY: Key for Pixabay stock video and photo search
PIXABAY_API_KEY="MY_PIXABAY_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
